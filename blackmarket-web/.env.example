# Website server -> remote backend URL (HTTPS, no trailing slash)
BLACKMARKET_BACKEND_URL=https://your-backend-host.example

# Signs an anonymous browser identity used only for community strategy ownership; not a login credential.
# Generate: node --input-type=module -e "import {randomBytes} from 'node:crypto'; console.log(randomBytes(48).toString('base64url'))"
BLACKMARKET_SESSION_SECRET=

# Backend bearer token; keep this server-side only.
BLACKMARKET_API_TOKEN=
