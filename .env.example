# BlackMarket AI - Configuration
# Copy this file to .env and customize as needed
# NEVER commit .env to version control!
# Binance credentials are not used; exchange access is public market data only.

# SYSTEM
APP_NAME=BLACKMARKET_AI
APP_ENV=development
LOG_LEVEL=INFO

# MARKET SCANNING
SPOT_ENABLED=true
USDM_FUTURES_ENABLED=true
SCAN_ALL_ELIGIBLE_SYMBOLS=true

# TIMEFRAMES
TIMEFRAMES=1m,3m,5m,15m,30m,1h,4h,1d,1w

# PAPER CAPITAL
SPOT_INITIAL_BALANCE=500
FUTURES_INITIAL_BALANCE=500

PAPER_TRADING_ENABLED=true
# Real trading is unsupported. Setting this to true fails startup validation.
REAL_TRADING_ENABLED=false

# RISK MANAGEMENT
RISK_PER_TRADE_PCT=0.5
RISK_MAX_DAILY_LOSS_PCT=2.0
RISK_MAX_TOTAL_OPEN_PCT=3.0
RISK_MAX_LEVERAGE=3
MAX_SPOT_POSITIONS=5
MAX_FUTURES_POSITIONS=5

# LEARNING
LEARNING_MODE=hybrid
ML_ENABLED=true
ADAPTIVE_LEARNING_ENABLED=true
AUTO_MODEL_TRAINING=true
AUTO_PAPER_TRADING_ENABLED=true
MODEL_VALIDATION_REQUIRED=true

# TELEGRAM
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DATABASE
DATABASE_URL=sqlite:///data/blackmarket.db

# HOSTED BACKEND (only when running FastAPI as a separately hosted service)
# Keep remote mode disabled for the local desktop backend.
# For a hosted backend, set these in the host's private environment:
# BLACKMARKET_REMOTE_API_ENABLED=1
# BLACKMARKET_API_HOST=0.0.0.0
# BLACKMARKET_API_TOKEN=<strong random bearer token, at least 32 bytes>
# BLACKMARKET_ALLOWED_ORIGINS=https://your-frontend-host.example
# Development browser proxy target (Vite only; URL, never a credential).
# Defaults to the local engine. Set to a reachable backend for development integration.
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8765
