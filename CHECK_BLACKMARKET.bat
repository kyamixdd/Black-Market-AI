@echo off
setlocal

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference = 'Stop'; $apps = @(Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowTitle -eq 'BlackMarket AI' }); if ($apps.Count -gt 0) { Write-Output 'Desktop app: RUNNING' } else { Write-Output 'Desktop app: NOT RUNNING' }; try { $response = Invoke-WebRequest -Uri 'http://127.0.0.1:8765/health' -TimeoutSec 3 -UseBasicParsing; $health = $response.Content | ConvertFrom-Json } catch { $http = $_.Exception.Response; if ($null -eq $http) { Write-Output ('Backend API: UNAVAILABLE (' + $_.Exception.Message + ')'); exit 1 }; $status = [int]$http.StatusCode; $reader = New-Object System.IO.StreamReader($http.GetResponseStream()); $body = $reader.ReadToEnd(); $reader.Dispose(); Write-Output ('Backend API: HTTP ' + $status + ' (' + $http.StatusDescription + ')'); if ($body) { Write-Output ('Response: ' + $body) }; if ($status -eq 500) { Write-Output 'The backend process is running but unhealthy. Quit any older BlackMarket AI instance from the notification-area tray, then run START_BLACKMARKET_DEV.bat again.'; Write-Output ('Backend log: ' + (Join-Path $env:APPDATA 'com.blackmarket.ai\logs\backend.log')) }; exit 1 }; if ($null -eq $health -or $null -eq $health.PSObject.Properties['backend_ready']) { Write-Output 'Backend API: RESPONDING, but this is not a BlackMarket AI health response.'; exit 2 }; Write-Output ('Backend: ' + $(if ($health.backend_ready -eq $true) { 'READY' } else { 'NOT READY' })); Write-Output ('Database: ' + $(if ($health.database_connected -eq $true) { 'CONNECTED' } else { 'NOT CONNECTED' })); Write-Output ('WebSocket service: ' + $(if ($health.websocket_connected -eq $true) { 'READY' } else { 'NOT READY' })); Write-Output ('Market data: ' + $(if ($health.market_data_active -eq $true) { 'ACTIVE' } else { 'INACTIVE' })); if ($health.backend_ready -eq $true -and $health.database_connected -eq $true -and $health.websocket_connected -eq $true) { exit 0 }; exit 2"
set "CHECK_RESULT=%ERRORLEVEL%"
echo.
pause
exit /b %CHECK_RESULT%
